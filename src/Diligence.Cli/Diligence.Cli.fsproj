<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>diligence</AssemblyName>
    <Version>0.4.0</Version>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Diligence.Core/Diligence.Core.fsproj" /><ProjectReference Include="../Diligence.Infrastructure/Diligence.Infrastructure.fsproj" /></ItemGroup>
  <ItemGroup>
    <None Include="../../assets/prompts/stock-review.md" Link="examples/stock-review.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../config.example.json" Link="config.example.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Compile Include="Program.fs" /></ItemGroup>
</Project>
